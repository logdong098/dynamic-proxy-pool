# ==========================================
# 服务基础配置
# ==========================================
HOST=0.0.0.0
PORT=8000
DEBUG=False
DATA_DIR=data
DB_PATH=data/proxies.db

# ==========================================
# Telegram UserBot 采集端配置 (可选)
# 用于监听群消息与自动下载文件附件
# 申请地址: https://my.telegram.org
# ==========================================
TG_API_ID=0
TG_API_HASH=
TG_SESSION_PATH=data/userbot.session
# 目标群组名称或用户名 (逗号分隔，留空则监听账号加入的所有群)
TG_TARGET_CHATS=老王技术交流分享群,otc_channel

# ==========================================
# Telegram Bot 查询端配置 (可选)
# 用于在 TG 中通过 /get 提取代理
# 申请方式: 在 TG 中私聊 @BotFather 创建机器人获取 Token
# ==========================================
TG_BOT_TOKEN=

# ==========================================
# 测活与调度配置
# ==========================================
CHECK_CONCURRENCY=50
CHECK_TIMEOUT=8.0
CHECK_INTERVAL_MINUTES=10
SCRAPE_INTERVAL_MINUTES=15
MAX_FAIL_COUNT=3
TARGET_COUNTRIES=PH,US,HK,SG,JP,TW,KR,GB,DE,VN,TH,ID,MY
